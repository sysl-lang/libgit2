// libgit2's C API (`git2.h`), declared verbatim.
//
// **The declarations over the library the machine has.** Nothing here is meant to be called by a
// program: every name and convention is C's, so an object is a pointer the caller frees with the
// matching `git_*_free`, a failure is a negative integer with the reason in `git_error_last()`, and a
// callback is one word of code with a `void *` beside it. The module above this one turns those into
// sysl and is what an application imports.
//
// **Every option struct is declared field by field** and `tests.sysl` asserts each one's size against
// the header's, so a libgit2 that grows a field fails a test rather than corrupting a call. The one
// exception is `git_clone_options`, which nests the fetch options, the remote callbacks and the proxy
// options — some forty fields of which a binding sets four. It is carried as storage the header sizes,
// and those four are written at the offsets the C compiler reports.

module sh.sysl.libgit2.c
@link("git2")

@include("stddef.h")
@include("git2.h")

opaque struct Repository
opaque struct Index
opaque struct IndexEntry
opaque struct Object
opaque struct Commit
opaque struct Tree
opaque struct TreeEntry
opaque struct TreeBuilder
opaque struct Blob
opaque struct Tag
opaque struct Reference
opaque struct BranchIterator
opaque struct Revwalk
opaque struct Diff
opaque struct Patch
opaque struct Blame
opaque struct Config
opaque struct Credential

// `git_oid`: twenty bytes of SHA-1. libgit2 is built without `GIT_EXPERIMENTAL_SHA256`, which would
// put a type byte in front; `tests.sysl` asserts the size, so a build with it fails there.
struct Oid
    id: [20]u8

// `git_time`.
struct Time
    time: i64
    offset: i32
    sign: u8

// `git_signature`.
struct Signature
    name: *u8
    email: *u8
    when: Time

// `git_error`.
struct Error
    message: *u8
    klass: i32

// `git_buf`, which the caller disposes of with `git_buf_dispose`.
struct Buf
    ptr: *u8
    reserved: usize
    size: usize

// `git_strarray`.
struct StrArray
    strings: **u8
    count: usize

type CheckoutNotifyCb = *extern(i32, *u8, *DiffFile, *DiffFile, *DiffFile, *u8) -> i32
type CheckoutProgressCb = *extern(*u8, usize, usize, *u8) -> unit
type CheckoutPerfdataCb = *extern(*u8, *u8) -> unit
type StatusCb = *extern(*u8, u32, *u8) -> i32
type DiffFileCb = *extern(*DiffDelta, f32, *u8) -> i32
type DiffBinaryCb = *extern(*DiffDelta, *u8, *u8) -> i32
type DiffHunkCb = *extern(*DiffDelta, *DiffHunk, *u8) -> i32
type DiffLineCb = *extern(*DiffDelta, *DiffHunk, *DiffLine, *u8) -> i32
type DiffNotifyCb = *extern(*Diff, *DiffDelta, *u8, *u8) -> i32
type DiffProgressCb = *extern(*Diff, *u8, *u8, *u8) -> i32
type StashCb = *extern(usize, *u8, *Oid, *u8) -> i32
type StashApplyProgressCb = *extern(i32, *u8) -> i32
type TagForeachCb = *extern(*u8, *Oid, *u8) -> i32
type CredentialAcquireCb = *extern(**Credential, *u8, *u8, u32, *u8) -> i32
type IndexerProgressCb = *extern(*IndexerProgress, *u8) -> i32

// `git_checkout_options`.
struct CheckoutOptions
    version: u32
    checkout_strategy: u32
    disable_filters: i32
    dir_mode: u32
    file_mode: u32
    file_open_flags: i32
    notify_flags: u32
    notify_cb: CheckoutNotifyCb
    notify_payload: *u8
    progress_cb: CheckoutProgressCb
    progress_payload: *u8
    paths: StrArray
    baseline: *Tree
    baseline_index: *Index
    target_directory: *u8
    ancestor_label: *u8
    our_label: *u8
    their_label: *u8
    perfdata_cb: CheckoutPerfdataCb
    perfdata_payload: *u8
end CheckoutOptions

// `git_status_options`.
struct StatusOptions
    version: u32
    show: i32
    flags: u32
    pathspec: StrArray
    baseline: *Tree
    rename_threshold: u16

// `git_diff_options`.
struct DiffOptions
    version: u32
    flags: u32
    ignore_submodules: i32
    pathspec: StrArray
    notify_cb: DiffNotifyCb
    progress_cb: DiffProgressCb
    payload: *u8
    context_lines: u32
    interhunk_lines: u32
    oid_type: i32
    id_abbrev: u16
    max_size: i64
    old_prefix: *u8
    new_prefix: *u8
end DiffOptions

// `git_diff_file`.
struct DiffFile
    id: Oid
    path: *u8
    size: u64
    flags: u32
    mode: u16
    id_abbrev: u16

// `git_diff_delta`.
struct DiffDelta
    status: i32
    flags: u32
    similarity: u16
    nfiles: u16
    old_file: DiffFile
    new_file: DiffFile

// `git_diff_hunk`; the header is not NUL-terminated, `header_len` is its length.
struct DiffHunk
    old_start: i32
    old_lines: i32
    new_start: i32
    new_lines: i32
    header_len: usize
    header: [128]u8

// `git_diff_line`; `content` is not NUL-terminated, `content_len` is its length.
struct DiffLine
    origin: u8
    old_lineno: i32
    new_lineno: i32
    num_lines: i32
    content_len: usize
    content_offset: i64
    content: *u8

// `git_blame_options`.
struct BlameOptions
    version: u32
    flags: u32
    min_match_characters: u16
    newest_commit: Oid
    oldest_commit: Oid
    min_line: usize
    max_line: usize

// `git_blame_hunk`.
struct BlameHunk
    lines_in_hunk: usize
    final_commit_id: Oid
    final_start_line_number: usize
    final_signature: *Signature
    final_committer: *Signature
    orig_commit_id: Oid
    orig_path: *u8
    orig_start_line_number: usize
    orig_signature: *Signature
    orig_committer: *Signature
    summary: *u8
    boundary: u8
end BlameHunk

// `git_stash_apply_options`.
struct StashApplyOptions
    version: u32
    flags: u32
    checkout_options: CheckoutOptions
    progress_cb: StashApplyProgressCb
    progress_payload: *u8

// `git_indexer_progress`.
struct IndexerProgress
    total_objects: u32
    indexed_objects: u32
    received_objects: u32
    local_objects: u32
    total_deltas: u32
    indexed_deltas: u32
    received_bytes: usize

