extern "git_libgit2_version" libgit2_version(major: *i32, minor: *i32, rev: *i32) -> i32
extern "git_error_last" error_last() -> *Error

// `git_libgit2_opts` is C-variadic: what follows the option is that option's arguments.
extern "git_libgit2_opts" libgit2_opts(option: i32, ...) -> i32

