c const
    OID_SIZE: usize = "sizeof(git_oid)"
    TIME_SIZE: usize = "sizeof(git_time)"
    SIGNATURE_SIZE: usize = "sizeof(git_signature)"
    ERROR_SIZE: usize = "sizeof(git_error)"
    BUF_SIZE: usize = "sizeof(git_buf)"
    STRARRAY_SIZE: usize = "sizeof(git_strarray)"
    CHECKOUT_OPTIONS_SIZE: usize = "sizeof(git_checkout_options)"
    STATUS_OPTIONS_SIZE: usize = "sizeof(git_status_options)"
    DIFF_OPTIONS_SIZE: usize = "sizeof(git_diff_options)"
    DIFF_FILE_SIZE: usize = "sizeof(git_diff_file)"
    DIFF_DELTA_SIZE: usize = "sizeof(git_diff_delta)"
    DIFF_HUNK_SIZE: usize = "sizeof(git_diff_hunk)"
    DIFF_LINE_SIZE: usize = "sizeof(git_diff_line)"
    BLAME_OPTIONS_SIZE: usize = "sizeof(git_blame_options)"
    BLAME_HUNK_SIZE: usize = "sizeof(git_blame_hunk)"
    STASH_APPLY_OPTIONS_SIZE: usize = "sizeof(git_stash_apply_options)"
    INDEXER_PROGRESS_SIZE: usize = "sizeof(git_indexer_progress)"
    OFFSET_HUNK_HEADER: usize = "offsetof(git_diff_hunk, header)"
    OFFSET_LINE_CONTENT: usize = "offsetof(git_diff_line, content)"
    OFFSET_BLAME_SUMMARY: usize = "offsetof(git_blame_hunk, summary)"
    OFFSET_STASH_CHECKOUT: usize = "offsetof(git_stash_apply_options, checkout_options)"

    // Each options struct is filled by its `_init` function in storage of this many 8-byte words.
    CHECKOUT_OPTIONS_WORDS: usize = "(sizeof(git_checkout_options) + 7) / 8"
    STATUS_OPTIONS_WORDS: usize = "(sizeof(git_status_options) + 7) / 8"
    DIFF_OPTIONS_WORDS: usize = "(sizeof(git_diff_options) + 7) / 8"
    BLAME_OPTIONS_WORDS: usize = "(sizeof(git_blame_options) + 7) / 8"
    STASH_APPLY_OPTIONS_WORDS: usize = "(sizeof(git_stash_apply_options) + 7) / 8"

    // `git_clone_options`, as storage the header sizes and the four fields this binding writes.
    CLONE_OPTIONS_WORDS: usize = "(sizeof(git_clone_options) + 7) / 8"
    CLONE_OPTIONS_ALIGN: usize = "_Alignof(git_clone_options)"
    CLONE_BARE: usize = "offsetof(git_clone_options, bare)"
    CLONE_CHECKOUT_BRANCH: usize = "offsetof(git_clone_options, checkout_branch)"
    CLONE_CHECKOUT_OPTS: usize = "offsetof(git_clone_options, checkout_opts)"
    CLONE_CREDENTIALS: usize = "offsetof(git_clone_options, fetch_opts.callbacks.credentials)"
    CLONE_TRANSFER_PROGRESS: usize = "offsetof(git_clone_options, fetch_opts.callbacks.transfer_progress)"
    CLONE_CALLBACKS_PAYLOAD: usize = "offsetof(git_clone_options, fetch_opts.callbacks.payload)"

    CHECKOUT_OPTIONS_VERSION: u32 = "GIT_CHECKOUT_OPTIONS_VERSION"
    STATUS_OPTIONS_VERSION: u32 = "GIT_STATUS_OPTIONS_VERSION"
    DIFF_OPTIONS_VERSION: u32 = "GIT_DIFF_OPTIONS_VERSION"
    BLAME_OPTIONS_VERSION: u32 = "GIT_BLAME_OPTIONS_VERSION"
    STASH_APPLY_OPTIONS_VERSION: u32 = "GIT_STASH_APPLY_OPTIONS_VERSION"
    CLONE_OPTIONS_VERSION: u32 = "GIT_CLONE_OPTIONS_VERSION"

    // `git_error_code`.
    OK: i32 = "GIT_OK"
    ERROR: i32 = "GIT_ERROR"
    ENOTFOUND: i32 = "GIT_ENOTFOUND"
    EEXISTS: i32 = "GIT_EEXISTS"
    EAMBIGUOUS: i32 = "GIT_EAMBIGUOUS"
    EBUFS: i32 = "GIT_EBUFS"
    EUSER: i32 = "GIT_EUSER"
    EBAREREPO: i32 = "GIT_EBAREREPO"
    EUNBORNBRANCH: i32 = "GIT_EUNBORNBRANCH"
    EUNMERGED: i32 = "GIT_EUNMERGED"
    ENONFASTFORWARD: i32 = "GIT_ENONFASTFORWARD"
    EINVALIDSPEC: i32 = "GIT_EINVALIDSPEC"
    ECONFLICT: i32 = "GIT_ECONFLICT"
    ELOCKED: i32 = "GIT_ELOCKED"
    EMODIFIED: i32 = "GIT_EMODIFIED"
    EAUTH: i32 = "GIT_EAUTH"
    ECERTIFICATE: i32 = "GIT_ECERTIFICATE"
    EAPPLIED: i32 = "GIT_EAPPLIED"
    EPEEL: i32 = "GIT_EPEEL"
    EEOF: i32 = "GIT_EEOF"
    EINVALID: i32 = "GIT_EINVALID"
    EUNCOMMITTED: i32 = "GIT_EUNCOMMITTED"
    EDIRECTORY: i32 = "GIT_EDIRECTORY"
    EMERGECONFLICT: i32 = "GIT_EMERGECONFLICT"
    PASSTHROUGH: i32 = "GIT_PASSTHROUGH"
    ITEROVER: i32 = "GIT_ITEROVER"
    EOWNER: i32 = "GIT_EOWNER"
    ENOTSUPPORTED: i32 = "GIT_ENOTSUPPORTED"
    EREADONLY: i32 = "GIT_EREADONLY"

    // `git_error_t`: numbered from zero without gaps, which `error.sysl`'s table relies on and
    // `tests.sysl` checks at both ends.
    ERROR_NONE: i32 = "GIT_ERROR_NONE"
    ERROR_REPOSITORY: i32 = "GIT_ERROR_REPOSITORY"
    ERROR_REFERENCE: i32 = "GIT_ERROR_REFERENCE"
    ERROR_CHECKOUT: i32 = "GIT_ERROR_CHECKOUT"
    ERROR_CALLBACK: i32 = "GIT_ERROR_CALLBACK"
    ERROR_GRAFTS: i32 = "GIT_ERROR_GRAFTS"

    OBJECT_ANY: i32 = "GIT_OBJECT_ANY"
    OBJECT_INVALID: i32 = "GIT_OBJECT_INVALID"
    OBJECT_COMMIT: i32 = "GIT_OBJECT_COMMIT"
    OBJECT_TREE: i32 = "GIT_OBJECT_TREE"
    OBJECT_BLOB: i32 = "GIT_OBJECT_BLOB"
    OBJECT_TAG: i32 = "GIT_OBJECT_TAG"

    FILEMODE_TREE: i32 = "GIT_FILEMODE_TREE"
    FILEMODE_BLOB: i32 = "GIT_FILEMODE_BLOB"
    FILEMODE_BLOB_EXECUTABLE: i32 = "GIT_FILEMODE_BLOB_EXECUTABLE"
    FILEMODE_LINK: i32 = "GIT_FILEMODE_LINK"
    FILEMODE_COMMIT: i32 = "GIT_FILEMODE_COMMIT"

    REFERENCE_DIRECT: i32 = "GIT_REFERENCE_DIRECT"
    REFERENCE_SYMBOLIC: i32 = "GIT_REFERENCE_SYMBOLIC"

    BRANCH_LOCAL: i32 = "GIT_BRANCH_LOCAL"
    BRANCH_REMOTE: i32 = "GIT_BRANCH_REMOTE"
    BRANCH_ALL: i32 = "GIT_BRANCH_ALL"

    REPOSITORY_OPEN_NO_SEARCH: u32 = "GIT_REPOSITORY_OPEN_NO_SEARCH"

    OPT_SET_SEARCH_PATH: i32 = "GIT_OPT_SET_SEARCH_PATH"
    CONFIG_LEVEL_PROGRAMDATA: i32 = "GIT_CONFIG_LEVEL_PROGRAMDATA"
    CONFIG_LEVEL_SYSTEM: i32 = "GIT_CONFIG_LEVEL_SYSTEM"
    CONFIG_LEVEL_XDG: i32 = "GIT_CONFIG_LEVEL_XDG"
    CONFIG_LEVEL_GLOBAL: i32 = "GIT_CONFIG_LEVEL_GLOBAL"

    REPOSITORY_STATE_NONE: i32 = "GIT_REPOSITORY_STATE_NONE"
    REPOSITORY_STATE_MERGE: i32 = "GIT_REPOSITORY_STATE_MERGE"
    REPOSITORY_STATE_REVERT: i32 = "GIT_REPOSITORY_STATE_REVERT"
    REPOSITORY_STATE_REVERT_SEQUENCE: i32 = "GIT_REPOSITORY_STATE_REVERT_SEQUENCE"
    REPOSITORY_STATE_CHERRYPICK: i32 = "GIT_REPOSITORY_STATE_CHERRYPICK"
    REPOSITORY_STATE_CHERRYPICK_SEQUENCE: i32 = "GIT_REPOSITORY_STATE_CHERRYPICK_SEQUENCE"
    REPOSITORY_STATE_BISECT: i32 = "GIT_REPOSITORY_STATE_BISECT"
    REPOSITORY_STATE_REBASE: i32 = "GIT_REPOSITORY_STATE_REBASE"
    REPOSITORY_STATE_REBASE_INTERACTIVE: i32 = "GIT_REPOSITORY_STATE_REBASE_INTERACTIVE"
    REPOSITORY_STATE_REBASE_MERGE: i32 = "GIT_REPOSITORY_STATE_REBASE_MERGE"
    REPOSITORY_STATE_APPLY_MAILBOX: i32 = "GIT_REPOSITORY_STATE_APPLY_MAILBOX"
    REPOSITORY_STATE_APPLY_MAILBOX_OR_REBASE: i32 = "GIT_REPOSITORY_STATE_APPLY_MAILBOX_OR_REBASE"

    SORT_NONE: u32 = "GIT_SORT_NONE"
    SORT_TOPOLOGICAL: u32 = "GIT_SORT_TOPOLOGICAL"
    SORT_TIME: u32 = "GIT_SORT_TIME"
    SORT_REVERSE: u32 = "GIT_SORT_REVERSE"

    CHECKOUT_SAFE: u32 = "GIT_CHECKOUT_SAFE"
    CHECKOUT_FORCE: u32 = "GIT_CHECKOUT_FORCE"

    DIFF_FORMAT_PATCH: i32 = "GIT_DIFF_FORMAT_PATCH"
    DIFF_INCLUDE_UNTRACKED: u32 = "GIT_DIFF_INCLUDE_UNTRACKED"
    DIFF_SHOW_UNTRACKED_CONTENT: u32 = "GIT_DIFF_SHOW_UNTRACKED_CONTENT"
    DIFF_RECURSE_UNTRACKED_DIRS: u32 = "GIT_DIFF_RECURSE_UNTRACKED_DIRS"

    DELTA_UNMODIFIED: i32 = "GIT_DELTA_UNMODIFIED"
    DELTA_ADDED: i32 = "GIT_DELTA_ADDED"
    DELTA_DELETED: i32 = "GIT_DELTA_DELETED"
    DELTA_MODIFIED: i32 = "GIT_DELTA_MODIFIED"
    DELTA_RENAMED: i32 = "GIT_DELTA_RENAMED"
    DELTA_COPIED: i32 = "GIT_DELTA_COPIED"
    DELTA_IGNORED: i32 = "GIT_DELTA_IGNORED"
    DELTA_UNTRACKED: i32 = "GIT_DELTA_UNTRACKED"
    DELTA_TYPECHANGE: i32 = "GIT_DELTA_TYPECHANGE"
    DELTA_UNREADABLE: i32 = "GIT_DELTA_UNREADABLE"
    DELTA_CONFLICTED: i32 = "GIT_DELTA_CONFLICTED"

    STATUS_SHOW_INDEX_AND_WORKDIR: i32 = "GIT_STATUS_SHOW_INDEX_AND_WORKDIR"
    STATUS_OPT_INCLUDE_UNTRACKED: u32 = "GIT_STATUS_OPT_INCLUDE_UNTRACKED"
    STATUS_OPT_RECURSE_UNTRACKED_DIRS: u32 = "GIT_STATUS_OPT_RECURSE_UNTRACKED_DIRS"
    STATUS_OPT_INCLUDE_IGNORED: u32 = "GIT_STATUS_OPT_INCLUDE_IGNORED"
    STATUS_OPT_RENAMES_HEAD_TO_INDEX: u32 = "GIT_STATUS_OPT_RENAMES_HEAD_TO_INDEX"
    STATUS_OPT_SORT_CASE_SENSITIVELY: u32 = "GIT_STATUS_OPT_SORT_CASE_SENSITIVELY"
    STATUS_INDEX_NEW: u32 = "GIT_STATUS_INDEX_NEW"
    STATUS_INDEX_MODIFIED: u32 = "GIT_STATUS_INDEX_MODIFIED"
    STATUS_INDEX_DELETED: u32 = "GIT_STATUS_INDEX_DELETED"
    STATUS_INDEX_RENAMED: u32 = "GIT_STATUS_INDEX_RENAMED"
    STATUS_INDEX_TYPECHANGE: u32 = "GIT_STATUS_INDEX_TYPECHANGE"
    STATUS_WT_NEW: u32 = "GIT_STATUS_WT_NEW"
    STATUS_WT_MODIFIED: u32 = "GIT_STATUS_WT_MODIFIED"
    STATUS_WT_DELETED: u32 = "GIT_STATUS_WT_DELETED"
    STATUS_WT_TYPECHANGE: u32 = "GIT_STATUS_WT_TYPECHANGE"
    STATUS_WT_RENAMED: u32 = "GIT_STATUS_WT_RENAMED"
    STATUS_IGNORED: u32 = "GIT_STATUS_IGNORED"
    STATUS_CONFLICTED: u32 = "GIT_STATUS_CONFLICTED"

    STASH_DEFAULT: u32 = "GIT_STASH_DEFAULT"
    STASH_INCLUDE_UNTRACKED: u32 = "GIT_STASH_INCLUDE_UNTRACKED"

    CREDENTIAL_USERPASS_PLAINTEXT: u32 = "GIT_CREDENTIAL_USERPASS_PLAINTEXT"
    CREDENTIAL_SSH_KEY: u32 = "GIT_CREDENTIAL_SSH_KEY"
    CREDENTIAL_DEFAULT: u32 = "GIT_CREDENTIAL_DEFAULT"

// Every struct this side lays out is the size and shape the header gives it, checked at compile time:
// a libgit2 that grows a field stops the build here rather than corrupting a call.
@assert(sizeof(Oid) == OID_SIZE, "git_oid is not the size libgit2 says it is")
@assert(sizeof(Time) == TIME_SIZE, "git_time is not the size libgit2 says it is")
@assert(sizeof(Signature) == SIGNATURE_SIZE, "git_signature is not the size libgit2 says it is")
@assert(sizeof(Error) == ERROR_SIZE, "git_error is not the size libgit2 says it is")
@assert(sizeof(Buf) == BUF_SIZE, "git_buf is not the size libgit2 says it is")
@assert(sizeof(StrArray) == STRARRAY_SIZE, "git_strarray is not the size libgit2 says it is")
@assert(sizeof(CheckoutOptions) == CHECKOUT_OPTIONS_SIZE, "git_checkout_options is not the size libgit2 says it is")
@assert(sizeof(StatusOptions) == STATUS_OPTIONS_SIZE, "git_status_options is not the size libgit2 says it is")
@assert(sizeof(DiffOptions) == DIFF_OPTIONS_SIZE, "git_diff_options is not the size libgit2 says it is")
@assert(sizeof(DiffFile) == DIFF_FILE_SIZE, "git_diff_file is not the size libgit2 says it is")
@assert(sizeof(DiffDelta) == DIFF_DELTA_SIZE, "git_diff_delta is not the size libgit2 says it is")
@assert(sizeof(DiffHunk) == DIFF_HUNK_SIZE, "git_diff_hunk is not the size libgit2 says it is")
@assert(sizeof(DiffLine) == DIFF_LINE_SIZE, "git_diff_line is not the size libgit2 says it is")
@assert(sizeof(BlameOptions) == BLAME_OPTIONS_SIZE, "git_blame_options is not the size libgit2 says it is")
@assert(sizeof(BlameHunk) == BLAME_HUNK_SIZE, "git_blame_hunk is not the size libgit2 says it is")
@assert(sizeof(StashApplyOptions) == STASH_APPLY_OPTIONS_SIZE, "git_stash_apply_options is not the size libgit2 says it is")
@assert(sizeof(IndexerProgress) == INDEXER_PROGRESS_SIZE, "git_indexer_progress is not the size libgit2 says it is")
@assert(offsetof(DiffHunk, header) == OFFSET_HUNK_HEADER, "git_diff_hunk.header is not where libgit2 puts it")
@assert(offsetof(DiffLine, content) == OFFSET_LINE_CONTENT, "git_diff_line.content is not where libgit2 puts it")
@assert(offsetof(BlameHunk, summary) == OFFSET_BLAME_SUMMARY, "git_blame_hunk.summary is not where libgit2 puts it")
@assert(offsetof(StashApplyOptions, checkout_options) == OFFSET_STASH_CHECKOUT, "git_stash_apply_options.checkout_options is not where libgit2 puts it")
@assert(CLONE_OPTIONS_ALIGN <= 8, "git_clone_options wants more than the 8-byte alignment its u64 storage gives")
